<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Job Posted</title>
        <link rel="stylesheet" href="styles/header.css">
        <link rel="stylesheet" href="/styles/confirm.css">
        <link rel="stylesheet" href="/styles/home.css">
        <link rel="icon" type="image/png" href="/images/favicon.png">
    </head>
    <body>
        <!-- Header -->
        <%- include('partials/header') %>

        <div id="confirm-card">
            <h1>Job Posted Successfully</h1>
            <p><strong>Job Title:</strong> <%= job.title %></p>
            <p><strong>Company:</strong> <%= job.company %></p>
            <p><strong>Trade Area:</strong> <%= job.tradeArea %></p>
            <p><strong>Location:</strong> <%= job.location %></p>
            <p><strong>Type:</strong> <%= job.jobType %></p>
            <p><strong>Hours:</strong> <%= job.hourType %></p>
            <p><strong>Post Date:</strong> <%= job.postDate %></p>
            <p><strong>Expires:</strong> <%= job.expirationDate %></p>
            <p><strong>Application Link:</strong> <a href="<%= job.applicationUrl %>" target="_blank">Apply Now</a></p>

            <div id="confirm-links">
                <a href="/add-job">Add another job</a>
                <a href="/jobs">View all jobs</a>
            </div>
        </div>

    </body>
</html>