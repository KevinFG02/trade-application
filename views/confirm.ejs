<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Job Posted</title>
        <link rel="stylesheet" href="styles/header.css">
        <link rel="stylesheet" href="/styles/confirm.css">
        <link rel="stylesheet" href="/styles/home.css">
        <link rel="icon" type="image/png" href="/images/favicon.png">
    </head>
    <body>
        <!-- Header -->
        <%- include('partials/header') %>

        <!-- Job Details -->
        <h1>Job Posted Successfully</h1>
        <p>Job Title: <%= job.title %></p>
        <p>Company: <%= job.company %></p>
        <p>Trade Area: <%= job.tradeArea %></p>
        <p>Location: <%= job.location %></p>
        <p>Type: <%= job.jobType %></p>
        <p>Hours: <%= job.hourType %></p>
        <p>Post Date: <%= job.postDate %></p>
        <p>Expires: <%= job.expirationDate %></p>
        <p>Application Link: <a href="<%= job.applicationUrl %>" target="_blank">Apply Now</a></p>

    </body>
</html>