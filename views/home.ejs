<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="/images/favicon.png">
        <title>Home Page</title>
        <link rel="stylesheet" href="styles/header.css">
        <link rel="stylesheet" href="styles/home.css">
        <link rel="stylesheet" href="styles/footer.css">
    </head>
    <body>
        <!-- Header -->
        <%- include('partials/header') %>

        <section id="hero">
            <h1>Trades Job Board</h1>
            <p>Find jobs and internships in welding, automotive, manufacturing, carpentry and mechatronics.</p>
        </section>
        
        <main>
            <!-- Recent Postings -->
            <section id="recentJobPosting">
                <h2 class="title">Recent Job Postings</h2>

                <% if (jobs.length === 0) { %>
                    <p class="empty">No current job listings. Please check back soon!</p>
                <% } %>

                <% jobs.forEach(job => { %>
                    <div class="recentJob">
                        <a href="/jobs"><%= job.jobTitle %></a>
                        <span><%= job.company %> · <%= job.location %></span>
                    </div>
                <% }); %>
            </section>
        </main>
        
        <!-- Footer -->
        <%- include('partials/footer') %>
    </body>
</html>